#!/usr/bin/env python3
"""Modular Backup Center command-line backend.

The Cockpit UI talks to this executable and consumes JSON output.
The MVP discovers modules automatically and adds safe, read-only verification
of existing backups before backup/restore actions are enabled.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any

APP_NAME = "modular-backup-center"
DEFAULT_CONFIG = Path("/etc/modular-backup-center/config.json")
DEFAULT_BACKUP_ROOT = Path("/var/lib/modular-backup-center/backups")


def run(*args: str) -> str:
    result = subprocess.run(
        args,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return result.stdout


def load_config() -> dict[str, Any]:
    config_path = Path(os.environ.get("MBC_CONFIG", DEFAULT_CONFIG))
    config: dict[str, Any] = {
        "backup_root": str(DEFAULT_BACKUP_ROOT),
    }

    if config_path.is_file():
        with config_path.open("r", encoding="utf-8") as handle:
            loaded = json.load(handle)
        if isinstance(loaded, dict):
            config.update(loaded)

    return config


def module_backup_dir(backup_root: Path, module_key: str) -> Path:
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", module_key):
        raise ValueError("Invalid module key")

    root = backup_root.resolve()
    module_dir = (root / module_key).resolve()
    if module_dir.parent != root:
        raise ValueError("Module path escapes backup root")
    return module_dir


def latest_backup_path(backup_root: Path, module_key: str) -> Path | None:
    module_dir = module_backup_dir(backup_root, module_key)
    if not module_dir.is_dir():
        return None

    candidates = [item for item in module_dir.iterdir() if item.is_dir() and not item.name.startswith(".")]
    if not candidates:
        return None

    return max(candidates, key=lambda item: item.stat().st_mtime)


def latest_backup(backup_root: Path, module_key: str) -> dict[str, Any] | None:
    latest = latest_backup_path(backup_root, module_key)
    if latest is None:
        return None

    stat = latest.stat()

    size = 0
    for root, _, files in os.walk(latest):
        for filename in files:
            try:
                size += (Path(root) / filename).stat().st_size
            except OSError:
                pass

    integrity = "unknown"
    checksum_file = latest / "SHA256SUMS"
    if checksum_file.is_file():
        integrity = "available"

    return {
        "name": latest.name,
        "created_at": datetime.fromtimestamp(stat.st_mtime).astimezone().isoformat(timespec="seconds"),
        "size_bytes": size,
        "integrity": integrity,
    }


def verify_latest(module_key: str) -> tuple[dict[str, Any], int]:
    config = load_config()
    backup_root = Path(config["backup_root"])

    try:
        latest = latest_backup_path(backup_root, module_key)
    except ValueError as exc:
        return {"ok": False, "module": module_key, "error": str(exc)}, 2

    if latest is None:
        return {"ok": False, "module": module_key, "error": "No backup found"}, 3

    checksum_file = latest / "SHA256SUMS"
    if not checksum_file.is_file():
        return {
            "ok": False,
            "module": module_key,
            "backup": latest.name,
            "error": "SHA256SUMS not found",
        }, 4

    try:
        entries = sum(
            1
            for line in checksum_file.read_text(encoding="utf-8", errors="replace").splitlines()
            if line.strip()
        )
    except OSError as exc:
        return {
            "ok": False,
            "module": module_key,
            "backup": latest.name,
            "error": str(exc),
        }, 5

    result = subprocess.run(
        ["sha256sum", "--check", "--strict", "SHA256SUMS"],
        cwd=latest,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )

    failed_lines = [
        line.strip()
        for line in (result.stdout + "\n" + result.stderr).splitlines()
        if "FAILED" in line or "WARNING" in line
    ]

    payload: dict[str, Any] = {
        "ok": result.returncode == 0,
        "module": module_key,
        "backup": latest.name,
        "checked_files": entries,
    }

    if result.returncode != 0:
        payload["error"] = "Checksum verification failed"
        payload["details"] = failed_lines[:20]

    return payload, 0 if result.returncode == 0 else 6


def docker_records() -> list[dict[str, Any]]:
    output = run("docker", "ps", "-a", "--no-trunc", "--format", "{{json .}}")
    records: list[dict[str, Any]] = []

    for line in output.splitlines():
        line = line.strip()
        if line:
            records.append(json.loads(line))

    return records


def inspect_container(container_id: str) -> dict[str, Any]:
    payload = json.loads(run("docker", "inspect", container_id))
    return payload[0]


def slug(value: str) -> str:
    cleaned = re.sub(r"[^a-z0-9._-]+", "-", value.lower()).strip("-._")
    return cleaned or "module"


def identify_module(
    raw_name: str,
    module_type: str,
    containers: list[dict[str, Any]],
) -> tuple[str, str, str]:
    """Return display name, backup key and adapter name.

    Generic modules need no hand-written configuration. Known applications can
    opt into a small adapter that provides a stable friendly identity and later
    application-aware backup/restore behaviour.
    """
    images = {str(item.get("image") or "").lower() for item in containers}

    if any(image.startswith("ghcr.io/openclaw/openclaw") for image in images):
        return "OpenClaw", "openclaw", "openclaw"

    if any(image.startswith("portainer/portainer-ce") for image in images):
        return "Portainer", "portainer", "portainer"

    if module_type == "compose" and raw_name.lower() == "ia-agent":
        return "IA-Agent", "ia-agent", "ia-agent"

    return raw_name, slug(raw_name), "generic"


def discover_docker_modules(backup_root: Path) -> list[dict[str, Any]]:
    groups: dict[str, list[dict[str, Any]]] = defaultdict(list)

    for record in docker_records():
        container_id = record.get("ID") or record.get("Names")
        if not container_id:
            continue

        info = inspect_container(container_id)
        labels = info.get("Config", {}).get("Labels") or {}
        compose_project = labels.get("com.docker.compose.project")
        name = info.get("Name", "").lstrip("/") or record.get("Names", container_id[:12])

        if compose_project:
            key = f"compose:{compose_project}"
            raw_module_name = compose_project
            module_type = "compose"
        else:
            key = f"container:{name}"
            raw_module_name = name
            module_type = "container"

        groups[key].append(
            {
                "id": info.get("Id"),
                "name": name,
                "image": info.get("Config", {}).get("Image"),
                "state": info.get("State", {}).get("Status", "unknown"),
                "labels": labels,
                "raw_module_name": raw_module_name,
                "module_type": module_type,
            }
        )

    modules: list[dict[str, Any]] = []
    for key, containers in sorted(groups.items(), key=lambda pair: pair[0].lower()):
        running = sum(1 for container in containers if container["state"] == "running")
        total = len(containers)

        if running == total:
            status = "running"
        elif running == 0:
            status = "stopped"
        else:
            status = "partial"

        raw_name = containers[0]["raw_module_name"]
        module_type = containers[0]["module_type"]
        display_name, backup_key, adapter = identify_module(raw_name, module_type, containers)

        modules.append(
            {
                "id": f"docker:{key}",
                "backup_key": backup_key,
                "name": display_name,
                "type": module_type,
                "adapter": adapter,
                "status": status,
                "containers": total,
                "running_containers": running,
                "container_names": [container["name"] for container in containers],
                "images": sorted({container["image"] for container in containers if container["image"]}),
                "last_backup": latest_backup(backup_root, backup_key),
                "capabilities": ["backup", "verify", "restore", "export"],
            }
        )

    return modules


def discover() -> dict[str, Any]:
    config = load_config()
    backup_root = Path(config["backup_root"])

    system_module = {
        "id": "system",
        "backup_key": "system",
        "name": "SYSTEM",
        "type": "system",
        "adapter": "system",
        "status": "running",
        "containers": 0,
        "running_containers": 0,
        "container_names": [],
        "images": [],
        "last_backup": latest_backup(backup_root, "system"),
        "capabilities": ["backup", "verify", "restore", "export"],
    }

    try:
        docker_modules = discover_docker_modules(backup_root)
        docker_error = None
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        docker_modules = []
        docker_error = str(exc)

    return {
        "app": APP_NAME,
        "version": "0.1.0-dev",
        "backup_root": str(backup_root),
        "modules": [system_module, *docker_modules],
        "docker_error": docker_error,
    }


def usage() -> dict[str, Any]:
    return {
        "app": APP_NAME,
        "commands": {
            "discover": "Discover SYSTEM and Docker modules (read-only)",
            "verify <backup-key>": "Verify SHA256 checksums of the latest backup (read-only)",
        },
    }


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "discover"

    if command in {"-h", "--help", "help"}:
        print(json.dumps(usage(), indent=2))
        return 0

    if command == "discover":
        print(json.dumps(discover(), indent=2, sort_keys=False))
        return 0

    if command == "verify":
        if len(sys.argv) != 3:
            print(json.dumps({"ok": False, "error": "Usage: mbcctl verify <backup-key>"}))
            return 2
        payload, exit_code = verify_latest(sys.argv[2])
        print(json.dumps(payload, indent=2, sort_keys=False))
        return exit_code

    print(json.dumps({"error": f"Unknown command: {command}"}))
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
